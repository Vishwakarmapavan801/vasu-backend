# Vasu Realty — Environment Configuration
# Copy to .env and fill in your values

# === Server ===
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vasu
DB_USER=postgres
DB_PASSWORD=admin

# === MLS Grid API ===
MLS_GRID_BASE_URL=https://api.mlsgrid.com/v2
MLS_GRID_API_KEY=
MLS_GRID_API_SECRET=

# === JotForm ===
JOTFORM_API_KEY=
JOTFORM_FORM_ID_CONTACT=
JOTFORM_FORM_ID_TOUR=
JOTFORM_FORM_ID_VALUATION=
JOTFORM_FORM_ID_NEWSLETTER=
JOTFORM_FORM_ID_PREAPPROVAL=
JOTFORM_FORM_ID_BUYER_AGENT=
JOTFORM_FORM_ID_AGENT_INQUIRY=
JOTFORM_FORM_ID_CALLBACK=
JOTFORM_FORM_ID_QUICK_QUESTION=
JOTFORM_FORM_ID_CAREER=
JOTFORM_FORM_ID_ONBOARDING=
JOTFORM_FORM_ID_SELLER_REQUEST=
JOTFORM_FORM_ID_AI_DEMO=
JOTFORM_FORM_ID_AI_CONTACT=
JOTFORM_FORM_ID_COOKIE_CONSENT=

# === JWT ===
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === Brokerage Configuration (REQUIRED) ===
FIRM_LICENSE=
SECONDARY_FIRM_LICENSE=
LIST_OFFICE_MLS_ID=
NC_AGENT_LICENSE=
SC_AGENT_LICENSE=
BROKERAGE_NAME=Vasu Realty
BROKERAGE_ADDRESS=
BROKERAGE_SECONDARY_ADDRESS=

# === OpenAI ===
OPENAI_API_KEY=

# === SendGrid (Email) ===
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vasurealty.com
SENDGRID_FROM_NAME=Vasu Realty
SG_TEMPLATE_WELCOME=
SG_TEMPLATE_VERIFY=
SG_TEMPLATE_RESET=
SG_TEMPLATE_AGENT_APPROVAL=
SG_TEMPLATE_INQUIRY=
SG_TEMPLATE_TOUR=
SG_TEMPLATE_TOUR_CONFIRMED=
SG_TEMPLATE_OFFER=
SG_TEMPLATE_OFFER_UPDATED=
SG_TEMPLATE_TX_MILESTONE=
SG_TEMPLATE_SUB_RECEIPT=
SG_TEMPLATE_PAYMENT_FAILURE=
SG_TEMPLATE_SEARCH_ALERT=
SG_TEMPLATE_PRICE_DROP=
SG_TEMPLATE_NEW_LISTING=

# === Resend (Email — primary transport for forgot-password / verification) ===
# When RESEND_API_KEY is set, src/services/emailService.js sends through Resend.
RESEND_API_KEY=
# Sender must be on a domain VERIFIED in the Resend account (see Resend dashboard →
# Domains). If the domain is not verified, Resend rejects the send with HTTP 403.
RESEND_FROM_EMAIL=noreply@vasurealty.com
RESEND_FROM_NAME=Vasu Realty

# === Twilio (SMS) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# === Stripe (Billing) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# === Redis (Queue) ===
REDIS_URL=redis://localhost:6379

# === Google Calendar ===
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary
AGENT_CALENDAR_EMAIL=

# === Sentry (Error Tracking) ===
SENTRY_DSN=
RELEASE_VERSION=1.0.0

# === AWS Backup (S3) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30

# === SEO / Business Info ===
BUSINESS_PHONE=
BUSINESS_STREET=123 Main St
BUSINESS_CITY=Charlotte
BUSINESS_STATE=NC
BUSINESS_ZIP=28202
BUSINESS_LAT=35.2271
BUSINESS_LNG=-80.8431

# === CORS ===
CORS_ALLOWED_ORIGINS=

# === Logging ===
LOG_LEVEL=debug

# === AutoSocial MCP (REQUIRED for AI blog generation) ===
# HMAC auth scheme:
#   signature = HMAC_SHA256(key = SHA256(HMAC_SECRET),
#                          data = "{timestamp}.{rawRequestBody}")
# Headers: X-AutoSocial-Key, X-MCP-Signature, X-Timestamp
AUTOSOCIAL_MCP_BASE_URL=
AUTOSOCIAL_API_KEY=
AUTOSOCIAL_HMAC_SECRET=
# Organization ID for the authenticated AutoSocial account (sent as X-Org-Id).
# Required by the MCP server for property/portfolio tool calls.
AUTOSOCIAL_ORG_ID=
# AUTOSOCIAL_MCP_TIMEOUT_MS=30000
# AUTOSOCIAL_MCP_MAX_RETRIES=3
# AUTOSOCIAL_SIGNATURE_ENCODING=hex        # hex | base64
# AUTOSOCIAL_TIMESTAMP_UNIT=s              # s | ms
# AUTOSOCIAL_MCP_PROTOCOL_VERSION=2024-11-05

# === AI Blog generation (OpenAI) ===
BLOG_OPENAI_MODEL=gpt-4o
BLOG_OPENAI_MAX_TOKENS=6000
BLOG_IMAGE_MODEL=dall-e-3            # dall-e-3 | gpt-image-1
BLOG_IMAGE_SIZE=1792x1024
BLOG_AUTHOR_NAME=Vasu Realty

# === Blog cover storage (S3-compatible; local fallback otherwise) ===
BLOG_S3_BUCKET=
BLOG_S3_REGION=us-east-1
BLOG_S3_ACCESS_KEY_ID=
BLOG_S3_SECRET_ACCESS_KEY=
# BLOG_S3_ENDPOINT=
# BLOG_S3_PUBLIC_BASE_URL=
# BLOG_S3_FORCE_PATH_STYLE=true

# === Blog social publishing (optional; jobs are SKIPPED when unset) ===
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
LINKEDIN_ACCESS_TOKEN=

# === Daily blog cron automation ===
BLOG_CRON_ENABLED=true
BLOG_CRON_TIME=08:00
BLOG_CRON_TZ=America/New_York
# BLOG_CRON_NOTIFY_TEMPLATE=d-blog-notify
